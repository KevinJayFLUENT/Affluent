# Copy to .env and paste your key — the agent goes live on next restart.
# Without it, the app runs on high-quality cached intelligence (demo-safe).
ANTHROPIC_API_KEY=sk-ant-...

# Optional durable store for deploys (locally the DB is server/data/db.json).
# Create a free Upstash Redis database and paste its REST credentials; the
# Vercel KV names (KV_REST_API_URL / KV_REST_API_TOKEN) work too.
# UPSTASH_REDIS_REST_URL=https://...upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
